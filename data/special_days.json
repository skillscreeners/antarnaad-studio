 "2026-11-14": {
  "name": "Children's Day",
  "slots": {
   "1": {
    "id": "childrensday-kalam-dreams",
    "lang": "hi",
    "theme": "life",
    "hook": "बाल दिवस पर कलाम साहब की सीख:",
    "lines": [
     "सपने वो नहीं",
     "जो आप नींद में देखते हैं,",
     "सपने वो हैं",
     "जो आपको सोने नहीं देते।"
    ],
    "subtitle": "Dreams are not what you see in sleep; they are what do not let you sleep.",
    "author": "डॉ. ए. पी. जे. अब्दुल कलाम",
    "author_en": "Dr. A. P. J. Abdul Kalam",
    "source": "Widely quoted from his talks to students",
    "topic_tags": [
     "#ChildrensDay",
     "#BalDiwas",
     "#APJAbdulKalam"
    ],
    "mood": "uplifting"
   },
   "2": {
    "id": "childrensday-tagore-child",
    "lang": "en",
    "theme": "life",
    "hook": "On Children's Day:",
    "lines": [
     "Every child comes",
     "with the message",
     "that God is not yet",
     "discouraged of man."
    ],
    "subtitle": "हर बच्चा यह संदेश लाता है कि ईश्वर अभी मनुष्य से निराश नहीं हुआ। बाल दिवस की शुभकामनाएँ!",
    "author": "Rabindranath Tagore",
    "author_en": "Rabindranath Tagore",
    "source": "Stray Birds, 77 (1916)",
    "topic_tags": [
     "#ChildrensDay",
     "#ChildrensDay2026",
     "#Tagore"
    ],
    "mood": "uplifting"
   },
   "3": {
    "id": "childrensday-einstein-imagination",
    "lang": "hi",
    "theme": "life",
    "hook": "बच्चों के लिए आइंस्टीन का मंत्र:",
    "lines": [
     "कल्पना",
     "ज्ञान से भी",
     "अधिक महत्वपूर्ण है।"
    ],
    "subtitle": "Imagination is more important than knowledge.",
    "author": "अल्बर्ट आइंस्टीन",
    "author_en": "Albert Einstein",
    "source": "Interview, The Saturday Evening Post, 26 Oct 1929",
    "topic_tags": [
     "#ChildrensDay",
     "#BalDiwas",
     "#Einstein"
    ],
    "mood": "rising"
   }
  }
