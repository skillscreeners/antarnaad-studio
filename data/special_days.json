 "2026-11-19": {
  "name": "Indira Gandhi Jayanti",
  "slots": {
   "2": {
    "id": "indira-two-kinds",
    "lang": "en",
    "theme": "work",
    "hook": "Indira Gandhi recalled:",
    "lines": [
     "There are two kinds of people:",
     "those who do the work",
     "and those who take the credit.",
     "Try to be in the first group;",
     "there is less competition there."
    ],
    "subtitle": "दो तरह के लोग होते हैं: जो काम करते हैं और जो श्रेय लेते हैं। पहले समूह में रहो।",
    "author": "Indira Gandhi",
    "author_en": "Indira Gandhi",
    "source": "Advice from her grandfather, as she often recalled",
    "topic_tags": [
     "#IndiraGandhi",
     "#WorkEthic",
     "#Leadership"
    ],
    "mood": "uplifting"
   },
   "3": {
    "id": "indira-two-kinds-hi",
    "lang": "hi",
    "theme": "work",
    "hook": "इंदिरा गांधी ने कहा:",
    "lines": [
     "दो तरह के लोग होते हैं —",
     "एक जो काम करते हैं,",
     "दूसरे जो श्रेय लेते हैं।",
     "पहले समूह में रहो,",
     "वहाँ भीड़ कम है।"
    ],
    "subtitle": "There are two kinds of people: those who do the work and those who take the credit.",
    "author": "इंदिरा गांधी",
    "author_en": "Indira Gandhi",
    "source": "Advice from her grandfather, as she often recalled",
    "topic_tags": [
