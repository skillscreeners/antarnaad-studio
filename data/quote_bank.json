  ],
  "subtitle": "हर छोटी चीज़ और हर व्यक्ति का अपना महत्व है।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#RespectEveryone",
   "#Suvichar"
  ]
 },
 {
  "id": "rahim-taruvar",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "तरुवर फल नहिं खात है,",
   "सरवर पियहि न पान।",
   "कहि रहीम पर काज हित,",
   "संपति सँचहि सुजान॥"
  ],
  "subtitle": "सज्जन अपनी संपत्ति दूसरों की भलाई के लिए जोड़ते हैं।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#Seva",
   "#Kindness"
  ]
 },
 {
  "id": "rahim-chandan",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "जो रहीम उत्तम प्रकृति,",
   "का करि सकत कुसंग।",
   "चंदन विष व्यापत नहीं,",
   "लिपटे रहत भुजंग॥"
  ],
  "subtitle": "अच्छे स्वभाव वाले को बुरी संगत नहीं बदल सकती।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#Character",
   "#Suvichar"
  ]
 },
 {
  "id": "rahim-pani",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "रहिमन पानी राखिए,",
   "बिन पानी सब सून।",
   "पानी गए न ऊबरै,",
   "मोती मानुष चून॥"
  ],
  "subtitle": "अपना सम्मान और मर्यादा हमेशा बनाए रखिए।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#SelfRespect",
   "#Suvichar"
  ]
 },
 {
  "id": "vrind-abhyas",
  "lang": "hi",
  "hook": "अभ्यास की शक्ति",
  "lines": [
   "करत-करत अभ्यास के,",
   "जड़मति होत सुजान।",
   "रसरी आवत जात ते,",
   "सिल पर परत निसान॥"
  ],
  "subtitle": "लगातार अभ्यास से कोई भी कुशल बन सकता है।",
  "author": "कवि वृंद",
  "author_en": "Kavi Vrind",
  "source": "Vrind Satsai",
  "topic_tags": [
   "#Practice",
   "#Consistency",
   "#HindiMotivation"
  ]
 },
 {
  "id": "tulsi-sansar",
  "lang": "hi",
  "hook": "तुलसीदास जी कहते हैं",
  "lines": [
   "तुलसी इस संसार में,",
   "भांति भांति के लोग।",
   "सबसे हिल मिल चालिए,",
   "नदी नाव संजोग॥"
  ],
  "subtitle": "सबके साथ मिल-जुलकर रहिए।",
  "author": "गोस्वामी तुलसीदास",
  "author_en": "Goswami Tulsidas",
  "source": "Tulsidas Dohavali",
  "topic_tags": [
   "#Tulsidas",
   "#Harmony",
   "#Suvichar"
  ]
 },
 {
  "id": "tulsi-daya",
  "lang": "hi",
  "hook": "तुलसीदास जी कहते हैं",
  "lines": [
   "दया धर्म का मूल है,",
   "पाप मूल अभिमान।",
   "तुलसी दया न छांड़िए,",
   "जब लग घट में प्राण॥"
  ],
  "subtitle": "दया सबसे बड़ा धर्म है, अभिमान सबसे बड़ा दोष।",
  "author": "गोस्वामी तुलसीदास",
  "author_en": "Goswami Tulsidas",
  "source": "Tulsidas Dohavali",
  "topic_tags": [
   "#Tulsidas",
   "#Compassion",
   "#Suvichar"
  ]
 },
 {
  "id": "hitopadesha-udyam",
  "lang": "hi",
  "hook": "मेहनत का मंत्र",
  "lines": [
   "उद्यमेन हि सिध्यन्ति",
   "कार्याणि न मनोरथैः।"
  ],
  "subtitle": "काम मेहनत से पूरे होते हैं, केवल इच्छा करने से नहीं।",
  "author": "हितोपदेश",
  "author_en": "Hitopadesha",
  "source": "Hitopadesha, Mitralabha",
  "topic_tags": [
   "#Sanskrit",
   "#HardWork",
   "#Subhashita"
  ]
 },
 {
  "id": "hitopadesha-vidya",
  "lang": "hi",
  "hook": "विद्या का फल",
  "lines": [
   "विद्या ददाति विनयं,",
   "विनयाद् याति पात्रताम्।"
  ],
  "subtitle": "विद्या विनम्रता देती है, और विनम्रता से योग्यता आती है।",
  "author": "हितोपदेश",
  "author_en": "Hitopadesha",
  "source": "Hitopadesha, Prastavika",
  "topic_tags": [
   "#Sanskrit",
   "#Education",
   "#Subhashita"
  ]
 },
 {
  "id": "upanishad-satyameva",
  "lang": "hi",
  "hook": "भारत का आदर्श वाक्य",
  "lines": [
   "सत्यमेव जयते।"
  ],
  "subtitle": "सत्य की ही विजय होती है।",
  "author": "मुण्डक उपनिषद् 3.1.6",
  "author_en": "Mundaka Upanishad 3.1.6",
  "source": "Mundaka Upanishad 3.1.6",
  "topic_tags": [
   "#SatyamevaJayate",
   "#ProudIndian",
   "#Truth"
  ]
 },
 {
  "id": "vasudhaiva",
  "lang": "hi",
  "hook": "भारत की सोच",
  "lines": [
   "अयं निजः परो वेति",
   "गणना लघुचेतसाम्।",
   "उदारचरितानां तु",
   "वसुधैव कुटुम्बकम्॥"
  ],
  "subtitle": "उदार हृदय वालों के लिए पूरी धरती एक परिवार है।",
  "author": "महा उपनिषद्",
  "author_en": "Maha Upanishad",
  "source": "Maha Upanishad 6.71–73",
  "topic_tags": [
   "#VasudhaivaKutumbakam",
   "#ProudIndian",
   "#Unity"
  ]
 },
 {
  "id": "gita-6-5",
  "lang": "hi",
  "hook": "गीता का संदेश",
  "lines": [
   "उद्धरेदात्मनात्मानं",
   "नात्मानमवसादयेत्।"
  ],
  "subtitle": "अपना उत्थान स्वयं करें, स्वयं को कभी गिरने न दें।",
  "author": "श्रीमद्भगवद्गीता 6.5",
  "author_en": "Bhagavad Gita 6.5",
  "source": "Bhagavad Gita, Chapter 6, Verse 5",
  "topic_tags": [
   "#BhagavadGita",
   "#SelfBelief",
   "#Suvichar"
  ]
 },
 {
  "id": "gupt-nar-ho",
  "lang": "hi",
  "hook": "मैथिलीशरण गुप्त की पंक्तियाँ",
  "lines": [
   "नर हो, न निराश करो मन को।",
   "कुछ काम करो, कुछ काम करो।",
   "जग में रह कर",
   "कुछ नाम करो॥"
  ],
  "subtitle": "हिम्मत मत हारो, कर्म करते रहो।",
  "author": "मैथिलीशरण गुप्त",
  "author_en": "Maithili Sharan Gupt",
  "source": "Nar Ho Na Nirash Karo Man Ko",
  "topic_tags": [
   "#MaithiliSharanGupt",
   "#HindiKavita",
   "#NeverGiveUp"
  ]
 },
 {
  "id": "confucius-reciprocity",
  "lang": "en",
  "hook": "One word to live by:",
  "lines": [
   "Do not impose",
   "on others what",
   "you yourself",
   "do not desire."
  ],
  "subtitle": "जो आप अपने लिए नहीं चाहते, वह दूसरों के साथ मत कीजिए।",
  "author": "Confucius",
  "author_en": "Confucius",
  "source": "Analects 15.24",
  "topic_tags": [
   "#Confucius",
   "#Kindness",
   "#LifeLessons"
  ]
 },
 {
  "id": "laozi-know-self",
  "lang": "en",
  "hook": "Lao Tzu on wisdom:",
  "lines": [
   "Knowing others",
   "is intelligence;",
   "knowing yourself",
   "is true wisdom."
  ],
  "subtitle": "दूसरों को जानना बुद्धि है, खुद को जानना सच्चा ज्ञान।",
  "author": "Lao Tzu",
  "author_en": "Lao Tzu",
  "source": "Tao Te Ching, Chapter 33",
  "topic_tags": [
   "#LaoTzu",
   "#SelfAwareness",
   "#Wisdom"
  ]
 },
 {
  "id": "seneca-postpone",
  "lang": "en",
  "hook": "Seneca's warning:",
  "lines": [
   "While we are",
   "postponing,",
   "life speeds by."
  ],
  "subtitle": "हम टालते रहते हैं और जीवन निकल जाता है।",
  "author": "Seneca",
  "author_en": "Seneca",
  "source": "Letters to Lucilius, Letter 1",
  "topic_tags": [
   "#Seneca",
   "#StartToday",
   "#Stoicism"
  ]
 },
 {
  "id": "seneca-imagination",
  "lang": "en",
  "hook": "Read this when you worry:",
  "lines": [
   "We suffer more often",
   "in imagination",
   "than in reality."
  ],
  "subtitle": "हम असल से ज़्यादा कल्पना में दुखी होते हैं।",
  "author": "Seneca",
  "author_en": "Seneca",
  "source": "Letters to Lucilius, Letter 13",
  "topic_tags": [
   "#Seneca",
   "#Overthinking",
   "#Stoicism"
  ]
 },
 {
  "id": "aurelius-obstacle",
  "lang": "en",
  "hook": "Marcus Aurelius on obstacles:",
  "lines": [
   "What stands",
   "in the way",
   "becomes the way."
  ],
  "subtitle": "जो रास्ते की रुकावट है, वही रास्ता बन जाती है।",
  "author": "Marcus Aurelius",
  "author_en": "Marcus Aurelius",
  "source": "Meditations, Book 5.20",
  "topic_tags": [
   "#MarcusAurelius",
   "#Resilience",
   "#Stoicism"
  ]
 },
 {
  "id": "aurelius-happy",
  "lang": "en",
  "hook": "A 2,000-year-old truth:",
  "lines": [
   "Very little is needed",
   "to make a happy life;",
   "it is all within yourself,",
   "in your way of thinking."
  ],
  "subtitle": "खुश रहने के लिए बहुत कम चाहिए — सब आपकी सोच में है।",
  "author": "Marcus Aurelius",
  "author_en": "Marcus Aurelius",
  "source": "Meditations, Book 7.67",
  "topic_tags": [
   "#MarcusAurelius",
   "#Happiness",
   "#Mindset"
  ]
 },
 {
  "id": "epictetus-master",
  "lang": "en",
  "hook": "Epictetus on freedom:",
  "lines": [
   "No man is free",
   "who is not",
   "master of himself."
  ],
  "subtitle": "जो खुद पर काबू नहीं रखता, वह आज़ाद नहीं।",
  "author": "Epictetus",
  "author_en": "Epictetus",
  "source": "Fragments (Stobaeus)",
  "topic_tags": [
   "#Epictetus",
   "#SelfDiscipline",
   "#Stoicism"
  ]
 },
 {
  "id": "epictetus-first-say",
  "lang": "en",
  "hook": "The simplest plan:",
  "lines": [
   "First say to yourself",
   "what you would be;",
   "and then do",
   "what you have to do."
  ],
  "subtitle": "पहले तय कीजिए क्या बनना है, फिर वही कीजिए।",
  "author": "Epictetus",
  "author_en": "Epictetus",
  "source": "Discourses, Book 3.23",
  "topic_tags": [
   "#Epictetus",
   "#Goals",
   "#Discipline"
  ]
 },
 {
  "id": "roosevelt-do-what",
  "lang": "en",
  "hook": "Start where you are:",
  "lines": [
   "Do what you can,",
   "with what you have,",
   "where you are."
  ],
  "subtitle": "जो है, जहाँ हैं, उसी से शुरू कीजिए।",
  "author": "Theodore Roosevelt",
  "author_en": "Theodore Roosevelt",
  "source": "An Autobiography, 1913",
  "topic_tags": [
   "#TheodoreRoosevelt",
   "#StartToday",
   "#Motivation"
  ]
 },
 {
  "id": "thoreau-dreams",
  "lang": "en",
  "hook": "Thoreau wrote this in 1854:",
  "lines": [
   "If one advances confidently",
   "in the direction of his dreams,",
   "he will meet with a success",
   "unexpected in common hours."
  ],
  "subtitle": "सपनों की ओर भरोसे से बढ़िए, सफलता खुद मिलेगी।",
  "author": "Henry David Thoreau",
  "author_en": "Henry David Thoreau",
  "source": "Walden, 1854",
  "topic_tags": [
   "#Thoreau",
   "#Dreams",
   "#Success"
  ]
 },
 {
  "id": "keller-together",
  "lang": "en",
  "hook": "Helen Keller on teamwork:",
  "lines": [
   "Alone we can do",
   "so little;",
   "together we can do",
   "so much."
  ],
  "subtitle": "अकेले हम थोड़ा कर पाते हैं, साथ मिलकर बहुत कुछ।",
  "author": "Helen Keller",
  "author_en": "Helen Keller",
  "source": "Quoted in Helen and Teacher, Joseph P. Lash, 1980",
  "topic_tags": [
   "#HelenKeller",
   "#Teamwork",
   "#Unity"
  ]
 },
 {
  "id": "einstein-bicycle",
  "lang": "en",
  "hook": "Einstein, in a letter to his son:",
  "lines": [
   "Life is like",
   "riding a bicycle.",
   "To keep your balance",
   "you must keep moving."
  ],
  "subtitle": "ज़िंदगी साइकिल जैसी है — संतुलन के लिए चलते रहना ज़रूरी है।",
  "author": "Albert Einstein",
  "author_en": "Albert Einstein",
  "source": "Letter to Eduard Einstein, 5 February 1930",
  "topic_tags": [
   "#AlbertEinstein",
   "#KeepMoving",
   "#LifeLessons"
  ]
 },
 {
  "id": "emerson-enthusiasm",
  "lang": "en",
  "hook": "Emerson knew:",
  "lines": [
   "Nothing great",
   "was ever achieved",
   "without enthusiasm."
  ],
  "subtitle": "उत्साह के बिना कुछ भी महान हासिल नहीं होता।",
  "author": "Ralph Waldo Emerson",
  "author_en": "Ralph Waldo Emerson",
  "source": "Circles, Essays: First Series, 1841",
  "topic_tags": [
   "#Emerson",
   "#Passion",
   "#Motivation"
  ]
 },
 {
  "id": "franklin-lost-time",
  "lang": "en",
  "hook": "Benjamin Franklin's reminder:",
  "lines": [
   "Lost time",
   "is never",
   "found again."
  ],
  "subtitle": "खोया हुआ समय फिर कभी नहीं मिलता।",
  "author": "Benjamin Franklin",
  "author_en": "Benjamin Franklin",
  "source": "Poor Richard's Almanack, 1748",
  "topic_tags": [
   "#BenjaminFranklin",
   "#TimeManagement",
   "#Discipline"
  ]
 },
 {
  "id": "tagore-butterfly",
  "lang": "en",
  "hook": "Tagore on living fully:",
  "lines": [
   "The butterfly counts",
   "not months but moments,",
   "and has",
   "time enough."
  ],
  "subtitle": "तितली महीने नहीं, पल गिनती है — और उसके पास पर्याप्त समय है।",
  "author": "Rabindranath Tagore",
  "author_en": "Rabindranath Tagore",
  "source": "Fireflies, 1928",
  "topic_tags": [
   "#RabindranathTagore",
   "#LiveInTheMoment",
   "#LifeQuotes"
  ]
 },
 {
  "id": "tagore-clouds",
  "lang": "en",
  "hook": "Tagore, Stray Birds:",
  "lines": [
   "Clouds come floating",
   "into my life,",
   "no longer to carry rain,",
   "but to add colour",
   "to my sunset sky."
  ],
  "subtitle": "बादल अब बारिश नहीं, मेरी शाम में रंग भरने आते हैं।",
  "author": "Rabindranath Tagore",
  "author_en": "Rabindranath Tagore",
  "source": "Stray Birds, 1916",
  "topic_tags": [
   "#RabindranathTagore",
   "#Positivity",
   "#GoodThoughts"
  ]
 },
 {
  "id": "kabir-mala",
  "lang": "hi",
  "hook": "कबीर की सीख",
  "lines": [
   "माला फेरत जुग भया,",
   "फिरा न मन का फेर।",
   "कर का मनका डार दे,",
   "मन का मनका फेर॥"
  ],
  "subtitle": "दिखावे से नहीं, मन बदलने से बदलाव आता है।",
  "author": "संत कबीर",
  "author_en": "Sant Kabir",
  "source": "Kabir Dohavali",
  "topic_tags": [
   "#Kabir",
   "#KabirKeDohe",
   "#InnerChange"
  ]
 },
 {
  "id": "kabir-bazaar",
  "lang": "hi",
  "hook": "कबीर का संदेश",
  "lines": [
   "कबीरा खड़ा बाज़ार में,",
   "मांगे सबकी खैर।",
   "ना काहू से दोस्ती,",
   "न काहू से बैर॥"
  ],
  "subtitle": "सबका भला चाहिए, किसी से बैर न रखिए।",
  "author": "संत कबीर",
  "author_en": "Sant Kabir",
  "source": "Kabir Dohavali",
  "topic_tags": [
   "#Kabir",
   "#Harmony",
   "#Suvichar"
  ]
 },
 {
  "id": "kabir-ati",
  "lang": "hi",
  "hook": "संतुलन का मंत्र",
  "lines": [
   "अति का भला न बोलना,",
   "अति की भली न चूप।",
   "अति का भला न बरसना,",
   "अति की भली न धूप॥"
  ],
  "subtitle": "हर चीज़ में संतुलन ही सबसे अच्छा है।",
  "author": "संत कबीर",
  "author_en": "Sant Kabir",
  "source": "Kabir Dohavali",
  "topic_tags": [
   "#Kabir",
   "#Balance",
   "#LifeLessons"
  ]
 },
 {
  "id": "kabir-man-ke-hare",
  "lang": "hi",
  "hook": "कबीर का मंत्र",
  "lines": [
   "मन के हारे हार है,",
   "मन के जीते जीत।"
  ],
  "subtitle": "हार और जीत पहले मन में होती है।",
  "author": "संत कबीर",
  "author_en": "Sant Kabir",
  "source": "Kabir Dohavali",
  "topic_tags": [
   "#Kabir",
   "#Mindset",
   "#NeverGiveUp"
  ]
 },
 {
  "id": "kabir-kumhar",
  "lang": "hi",
  "hook": "गुरु की महिमा",
  "lines": [
   "गुरु कुम्हार शिष कुंभ है,",
   "गढ़ि गढ़ि काढ़ै खोट।",
   "अन्तर हाथ सहार दै,",
   "बाहर बाहै चोट॥"
  ],
  "subtitle": "सच्चा गुरु बाहर से सख़्त, भीतर से सहारा देता है।",
  "author": "संत कबीर",
  "author_en": "Sant Kabir",
  "source": "Kabir Dohavali",
  "topic_tags": [
   "#Kabir",
   "#Guru",
   "#Teachers"
  ]
 },
 {
  "id": "kabir-sanch",
  "lang": "hi",
  "hook": "सच की ताक़त",
  "lines": [
   "साँच बराबर तप नहीं,",
   "झूठ बराबर पाप।",
   "जाके हिरदै साँच है,",
   "ताकै हिरदै आप॥"
  ],
  "subtitle": "सच्चाई से बड़ा कोई तप नहीं।",
  "author": "संत कबीर",
  "author_en": "Sant Kabir",
  "source": "Kabir Dohavali",
  "topic_tags": [
   "#Kabir",
   "#Truth",
   "#Suvichar"
  ]
 },
 {
  "id": "rahim-vipda",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "रहिमन विपदा हू भली,",
   "जो थोरे दिन होय।",
   "हित अनहित या जगत में,",
   "जानि परत सब कोय॥"
  ],
  "subtitle": "मुश्किल समय दिखा देता है कौन सच्चा अपना है।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#TrueFriends",
   "#Suvichar"
  ]
 },
 {
  "id": "rahim-bigri",
  "lang": "hi",
  "hook": "रहीम की सलाह",
  "lines": [
   "बिगरी बात बनै नहीं,",
   "लाख करौ किन कोय।",
   "रहिमन बिगरे दूध को,",
   "मथे न माखन होय॥"
  ],
  "subtitle": "बोलने और करने से पहले सोचिए।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#ThinkBeforeYouSpeak",
   "#Suvichar"
  ]
 },
 {
  "id": "rahim-garib",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "जे गरीब पर हित करैं,",
   "ते रहीम बड़ लोग।",
   "कहा सुदामा बापुरो,",
   "कृष्ण मिताई जोग॥"
  ],
  "subtitle": "बड़ा वही है जो कमज़ोर का साथ दे।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#Kindness",
   "#Friendship"
  ]
 },
 {
  "id": "rahim-chup",
  "lang": "hi",
  "hook": "धैर्य का दोहा",
  "lines": [
   "रहिमन चुप हो बैठिए,",
   "देखि दिनन के फेर।",
   "जब नीके दिन आइहैं,",
   "बनत न लगिहैं देर॥"
  ],
  "subtitle": "बुरा समय भी बीत जाएगा — धैर्य रखिए।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#Patience",
   "#Hope"
  ]
 },
 {
  "id": "rahim-chhama",
  "lang": "hi",
  "hook": "क्षमा का बल",
  "lines": [
   "छमा बड़न को चाहिए,",
   "छोटन को उतपात।",
   "कह रहीम हरि का घट्यो,",
   "जो भृगु मारी लात॥"
  ],
  "subtitle": "क्षमा करना बड़प्पन की निशानी है।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#Forgiveness",
   "#Suvichar"
  ]
 },
 {
  "id": "tulsi-sathi",
  "lang": "hi",
  "hook": "मुश्किल के साथी",
  "lines": [
   "तुलसी साथी विपत्ति के,",
   "विद्या विनय विवेक।",
   "साहस सुकृति सुसत्यव्रत,",
   "राम भरोसो एक॥"
  ],
  "subtitle": "मुश्किल में विद्या, विनम्रता, विवेक और साहस ही साथ देते हैं।",
  "author": "गोस्वामी तुलसीदास",
  "author_en": "Goswami Tulsidas",
  "source": "Tulsidas Dohavali",
  "topic_tags": [
   "#Tulsidas",
   "#Courage",
   "#Wisdom"
  ]
 },
 {
  "id": "tulsi-aavat",
  "lang": "hi",
  "hook": "तुलसीदास जी कहते हैं",
  "lines": [
   "आवत ही हरषै नहीं,",
   "नैनन नहीं सनेह।",
   "तुलसी तहां न जाइए,",
   "कंचन बरसे मेह॥"
  ],
  "subtitle": "जहाँ सम्मान न हो, वहाँ मत जाइए।",
  "author": "गोस्वामी तुलसीदास",
  "author_en": "Goswami Tulsidas",
  "source": "Tulsidas Dohavali",
  "topic_tags": [
   "#Tulsidas",
   "#SelfRespect",
   "#Suvichar"
  ]
 },
 {
  "id": "gita-2-14",
  "lang": "hi",
  "hook": "गीता का संदेश",
  "lines": [
   "मात्रास्पर्शास्तु कौन्तेय",
   "शीतोष्णसुखदुःखदाः।",
   "आगमापायिनोऽनित्या:",
   "तांस्तितिक्षस्व भारत॥"
  ],
  "subtitle": "सुख-दुख आते-जाते रहते हैं — उन्हें धैर्य से सहिए।",
  "author": "श्रीमद्भगवद्गीता 2.14",
  "author_en": "Bhagavad Gita 2.14",
  "source": "Bhagavad Gita, Chapter 2, Verse 14",
  "topic_tags": [
   "#BhagavadGita",
   "#Resilience",
   "#Suvichar"
  ]
 },
 {
  "id": "gita-3-21",
  "lang": "hi",
  "hook": "नेतृत्व का सूत्र",
  "lines": [
   "यद्यदाचरति श्रेष्ठ:",
   "तत्तदेवेतरो जनः।"
  ],
  "subtitle": "बड़े लोग जैसा करते हैं, बाकी लोग वैसा ही करते हैं।",
  "author": "श्रीमद्भगवद्गीता 3.21",
  "author_en": "Bhagavad Gita 3.21",
  "source": "Bhagavad Gita, Chapter 3, Verse 21",
  "topic_tags": [
   "#BhagavadGita",
   "#Leadership",
   "#LeadByExample"
  ]
 },
 {
  "id": "gita-2-50",
  "lang": "hi",
  "hook": "काम का मंत्र",
  "lines": [
   "योगः कर्मसु कौशलम्।"
  ],
  "subtitle": "काम में कुशलता ही योग है।",
  "author": "श्रीमद्भगवद्गीता 2.50",
  "author_en": "Bhagavad Gita 2.50",
  "source": "Bhagavad Gita, Chapter 2, Verse 50",
  "topic_tags": [
   "#BhagavadGita",
   "#Excellence",
   "#WorkEthic"
  ]
 },
 {
  "id": "upanishad-asato",
  "lang": "hi",
  "hook": "सबसे सुंदर प्रार्थना",
  "lines": [
   "असतो मा सद्गमय।",
   "तमसो मा ज्योतिर्गमय।",
   "मृत्योर्मा अमृतं गमय॥"
  ],
  "subtitle": "असत्य से सत्य की ओर, अंधकार से प्रकाश की ओर ले चलो।",
  "author": "बृहदारण्यक उपनिषद् 1.3.28",
  "author_en": "Brihadaranyaka Upanishad 1.3.28",
  "source": "Brihadaranyaka Upanishad 1.3.28",
  "topic_tags": [
   "#Upanishad",
   "#Light",
   "#Prayer"
  ]
 },
 {
  "id": "subhashita-vidyarthi",
  "lang": "hi",
  "hook": "विद्यार्थी के पाँच गुण",
  "lines": [
   "काक चेष्टा बको ध्यानं,",
   "श्वान निद्रा तथैव च।",
   "अल्पाहारी गृहत्यागी,",
   "विद्यार्थी पंच लक्षणम्॥"
  ],
  "subtitle": "कौवे-सी लगन, बगुले-सा ध्यान, कुत्ते-सी नींद, कम भोजन — यही विद्यार्थी के गुण।",
  "author": "संस्कृत सुभाषित",
  "author_en": "Sanskrit Subhashita",
  "source": "Traditional Sanskrit subhashita",
  "topic_tags": [
   "#Sanskrit",
   "#Students",
   "#StudyMotivation"
  ]
 },
 {
  "id": "sarve-bhavantu",
  "lang": "hi",
  "hook": "सबके लिए शुभकामना",
  "lines": [
   "सर्वे भवन्तु सुखिनः,",
   "सर्वे सन्तु निरामयाः।"
  ],
  "subtitle": "सब सुखी हों, सब स्वस्थ हों।",
  "author": "शांति मंत्र",
  "author_en": "Shanti Mantra",
  "source": "Traditional Sanskrit shanti mantra",
  "topic_tags": [
   "#Sanskrit",
   "#Peace",
   "#Wellbeing"
  ]
 },
 {
  "id": "subhadra-jhansi",
  "lang": "hi",
  "hook": "सुभद्रा कुमारी चौहान की पंक्तियाँ",
  "lines": [
   "बुंदेले हरबोलों के मुँह",
   "हमने सुनी कहानी थी,",
   "खूब लड़ी मर्दानी वह तो",
   "झाँसी वाली रानी थी॥"
  ],
  "subtitle": "साहस की मिसाल — रानी लक्ष्मीबाई।",
  "author": "सुभद्रा कुमारी चौहान",
  "author_en": "Subhadra Kumari Chauhan",
  "source": "Jhansi Ki Rani (poem), 1930",
  "topic_tags": [
   "#JhansiKiRani",
   "#Courage",
   "#ProudIndian"
  ]
 },
 {
  "id": "prasad-himadri",
  "lang": "hi",
  "hook": "जयशंकर प्रसाद की पंक्तियाँ",
  "lines": [
   "हिमाद्रि तुंग शृंग से",
   "प्रबुद्ध शुद्ध भारती,",
   "स्वयं प्रभा समुज्ज्वला",
   "स्वतंत्रता पुकारती॥"
  ],
  "subtitle": "हिमालय की चोटियों से भारत माता पुकार रही है।",
  "author": "जयशंकर प्रसाद",
  "author_en": "Jaishankar Prasad",
  "source": "Chandragupta (play), 1931",
  "topic_tags": [
   "#JaishankarPrasad",
   "#HindiKavita",
   "#ProudIndian"
  ]
 },
 {
  "id": "bharatendu-nij-bhasha",
  "lang": "hi",
  "hook": "भारतेन्दु हरिश्चंद्र",
  "lines": [
   "निज भाषा उन्नति अहै,",
   "सब उन्नति को मूल।"
  ],
  "subtitle": "अपनी भाषा की उन्नति ही हर उन्नति की जड़ है।",
  "author": "भारतेन्दु हरिश्चंद्र",
  "author_en": "Bharatendu Harishchandra",
  "source": "Nij Bhasha (poem), 1877",
  "topic_tags": [
   "#Bharatendu",
   "#HindiDiwas",
   "#ProudIndian"
  ]
 },
 {
  "id": "iqbal-saare-jahan",
  "lang": "hi",
  "hook": "इक़बाल की पंक्तियाँ",
  "lines": [
   "सारे जहाँ से अच्छा,",
   "हिन्दोस्ताँ हमारा।",
   "हम बुलबुलें हैं इसकी,",
   "यह गुलसिताँ हमारा॥"
  ],
  "subtitle": "Better than the whole world is our India.",
  "author": "मुहम्मद इक़बाल",
  "author_en": "Muhammad Iqbal",
  "source": "Tarana-e-Hind, 1904",
  "topic_tags": [
   "#SaareJahanSeAchha",
   "#ProudIndian",
   "#India"
  ]
 },
 {
  "id": "aurelius-revenge",
  "lang": "en",
  "hook": "Marcus Aurelius on enemies:",
  "lines": [
   "The best revenge",
   "is not to be",
   "like your enemy."
  ],
  "subtitle": "सबसे अच्छा बदला है, दुश्मन जैसा न बनना।",
  "author": "Marcus Aurelius",
  "author_en": "Marcus Aurelius",
  "source": "Meditations, Book 6.6",
  "topic_tags": [
   "#MarcusAurelius",
   "#Character",
   "#Stoicism"
  ]
 },
 {
  "id": "seneca-chance",
  "lang": "en",
  "hook": "Seneca, Letter 76:",
  "lines": [
   "No man",
   "was ever wise",
   "by chance."
  ],
  "subtitle": "कोई भी संयोग से बुद्धिमान नहीं बनता।",
  "author": "Seneca",
  "author_en": "Seneca",
  "source": "Letters to Lucilius, Letter 76",
  "topic_tags": [
   "#Seneca",
   "#Learning",
   "#Stoicism"
  ]
 },
 {
  "id": "seneca-poor",
  "lang": "en",
  "hook": "Seneca on wealth:",
  "lines": [
   "It is not the man",
   "who has too little,",
   "but the man who craves more,",
   "that is poor."
  ],
  "subtitle": "गरीब वह नहीं जिसके पास कम है, गरीब वह है जो और चाहता है।",
  "author": "Seneca",
  "author_en": "Seneca",
  "source": "Letters to Lucilius, Letter 2",
  "topic_tags": [
   "#Seneca",
   "#Contentment",
   "#Stoicism"
  ]
 },
 {
  "id": "epictetus-views",
  "lang": "en",
  "hook": "Epictetus on worry:",
  "lines": [
   "Men are disturbed",
   "not by things,",
   "but by the views",
   "they take of things."
  ],
  "subtitle": "हमें चीज़ें नहीं, उनके बारे में हमारी सोच परेशान करती है।",
  "author": "Epictetus",
  "author_en": "Epictetus",
  "source": "Enchiridion, 5",
  "topic_tags": [
   "#Epictetus",
   "#Mindset",
   "#Stoicism"
  ]
 },
 {
  "id": "epictetus-improve",
  "lang": "en",
  "hook": "The price of growth:",
  "lines": [
   "If you want to improve,",
   "be content to be thought",
   "foolish and stupid."
  ],
  "subtitle": "सुधरना है तो लोगों की राय की परवाह छोड़िए।",
  "author": "Epictetus",
  "author_en": "Epictetus",
  "source": "Enchiridion, 13",
  "topic_tags": [
   "#Epictetus",
   "#Growth",
   "#Stoicism"
  ]
 },
 {
  "id": "laozi-conquer-self",
  "lang": "en",
  "hook": "Lao Tzu on strength:",
  "lines": [
   "He who conquers others",
   "is strong;",
   "he who conquers himself",
   "is mighty."
  ],
  "subtitle": "दूसरों को जीतने वाला ताक़तवर है, खुद को जीतने वाला महान।",
  "author": "Lao Tzu",
  "author_en": "Lao Tzu",
  "source": "Tao Te Ching, Chapter 33",
  "topic_tags": [
   "#LaoTzu",
   "#SelfDiscipline",
   "#Wisdom"
  ]
 },
 {
  "id": "confucius-knowledge",
  "lang": "en",
  "hook": "Confucius on knowledge:",
  "lines": [
   "To know what you know",
   "and what you do not know,",
   "that is",
   "true knowledge."
  ],
  "subtitle": "क्या जानते हैं और क्या नहीं — यह जानना ही सच्चा ज्ञान है।",
  "author": "Confucius",
  "author_en": "Confucius",
  "source": "Analects 2.17",
  "topic_tags": [
   "#Confucius",
   "#Knowledge",
   "#Wisdom"
  ]
 },
 {
  "id": "confucius-superior",
  "lang": "en",
  "hook": "Confucius, Analects 15.21:",
  "lines": [
   "The superior man",
   "seeks what is in himself;",
   "the small man seeks",
   "what is in others."
  ],
  "subtitle": "महान व्यक्ति खुद में खोजता है, छोटा व्यक्ति दूसरों में।",
  "author": "Confucius",
  "author_en": "Confucius",
  "source": "Analects 15.21",
  "topic_tags": [
   "#Confucius",
   "#SelfImprovement",
   "#Character"
  ]
 },
 {
  "id": "aristotle-just-acts",
  "lang": "en",
  "hook": "Aristotle on habits:",
  "lines": [
   "We become just",
   "by doing just acts,",
   "brave by doing",
   "brave acts."
  ],
  "subtitle": "अच्छे काम करते-करते ही हम अच्छे बनते हैं।",
  "author": "Aristotle",
  "author_en": "Aristotle",
  "source": "Nicomachean Ethics, Book 2",
  "topic_tags": [
   "#Aristotle",
   "#Habits",
   "#Character"
  ]
 },
 {
  "id": "franklin-early",
  "lang": "en",
  "hook": "Benjamin Franklin, 1735:",
  "lines": [
   "Early to bed",
   "and early to rise,",
   "makes a man healthy,",
   "wealthy and wise."
  ],
  "subtitle": "जल्दी सोना, जल्दी उठना — सेहत, धन और बुद्धि की कुंजी।",
  "author": "Benjamin Franklin",
  "author_en": "Benjamin Franklin",
  "source": "Poor Richard's Almanack, 1735",
  "topic_tags": [
   "#BenjaminFranklin",
   "#MorningRoutine",
   "#Discipline"
  ]
 },
 {
  "id": "franklin-diligence",
  "lang": "en",
  "hook": "Franklin on luck:",
  "lines": [
   "Diligence",
   "is the mother",
   "of good luck."
  ],
  "subtitle": "मेहनत ही अच्छी किस्मत की जननी है।",
  "author": "Benjamin Franklin",
  "author_en": "Benjamin Franklin",
  "source": "The Way to Wealth, 1758",
  "topic_tags": [
   "#BenjaminFranklin",
