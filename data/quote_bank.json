  ],
  "subtitle": "हर छोटी चीज़ और हर व्यक्ति का अपना महत्व है।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#RespectEveryone",
   "#Suvichar"
  ]
 },
 {
  "id": "rahim-taruvar",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "तरुवर फल नहिं खात है,",
   "सरवर पियहि न पान।",
   "कहि रहीम पर काज हित,",
   "संपति सँचहि सुजान॥"
  ],
  "subtitle": "सज्जन अपनी संपत्ति दूसरों की भलाई के लिए जोड़ते हैं।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#Seva",
   "#Kindness"
  ]
 },
 {
  "id": "rahim-chandan",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "जो रहीम उत्तम प्रकृति,",
   "का करि सकत कुसंग।",
   "चंदन विष व्यापत नहीं,",
   "लिपटे रहत भुजंग॥"
  ],
  "subtitle": "अच्छे स्वभाव वाले को बुरी संगत नहीं बदल सकती।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#Character",
   "#Suvichar"
  ]
 },
 {
  "id": "rahim-pani",
  "lang": "hi",
  "hook": "रहीम का दोहा",
  "lines": [
   "रहिमन पानी राखिए,",
   "बिन पानी सब सून।",
   "पानी गए न ऊबरै,",
   "मोती मानुष चून॥"
  ],
  "subtitle": "अपना सम्मान और मर्यादा हमेशा बनाए रखिए।",
  "author": "रहीम",
  "author_en": "Abdul Rahim Khan-i-Khanan",
  "source": "Rahim Dohavali",
  "topic_tags": [
   "#Rahim",
   "#SelfRespect",
   "#Suvichar"
  ]
 },
 {
  "id": "vrind-abhyas",
  "lang": "hi",
  "hook": "अभ्यास की शक्ति",
  "lines": [
   "करत-करत अभ्यास के,",
   "जड़मति होत सुजान।",
   "रसरी आवत जात ते,",
   "सिल पर परत निसान॥"
  ],
  "subtitle": "लगातार अभ्यास से कोई भी कुशल बन सकता है।",
  "author": "कवि वृंद",
  "author_en": "Kavi Vrind",
  "source": "Vrind Satsai",
  "topic_tags": [
   "#Practice",
   "#Consistency",
   "#HindiMotivation"
  ]
 },
 {
  "id": "tulsi-sansar",
  "lang": "hi",
  "hook": "तुलसीदास जी कहते हैं",
  "lines": [
   "तुलसी इस संसार में,",
   "भांति भांति के लोग।",
   "सबसे हिल मिल चालिए,",
   "नदी नाव संजोग॥"
  ],
  "subtitle": "सबके साथ मिल-जुलकर रहिए।",
  "author": "गोस्वामी तुलसीदास",
  "author_en": "Goswami Tulsidas",
  "source": "Tulsidas Dohavali",
  "topic_tags": [
   "#Tulsidas",
   "#Harmony",
   "#Suvichar"
  ]
 },
 {
  "id": "tulsi-daya",
  "lang": "hi",
  "hook": "तुलसीदास जी कहते हैं",
  "lines": [
   "दया धर्म का मूल है,",
   "पाप मूल अभिमान।",
   "तुलसी दया न छांड़िए,",
   "जब लग घट में प्राण॥"
  ],
  "subtitle": "दया सबसे बड़ा धर्म है, अभिमान सबसे बड़ा दोष।",
  "author": "गोस्वामी तुलसीदास",
  "author_en": "Goswami Tulsidas",
  "source": "Tulsidas Dohavali",
  "topic_tags": [
   "#Tulsidas",
   "#Compassion",
   "#Suvichar"
  ]
 },
 {
  "id": "hitopadesha-udyam",
  "lang": "hi",
  "hook": "मेहनत का मंत्र",
  "lines": [
   "उद्यमेन हि सिध्यन्ति",
   "कार्याणि न मनोरथैः।"
  ],
  "subtitle": "काम मेहनत से पूरे होते हैं, केवल इच्छा करने से नहीं।",
  "author": "हितोपदेश",
  "author_en": "Hitopadesha",
  "source": "Hitopadesha, Mitralabha",
  "topic_tags": [
   "#Sanskrit",
   "#HardWork",
   "#Subhashita"
  ]
 },
 {
  "id": "hitopadesha-vidya",
  "lang": "hi",
  "hook": "विद्या का फल",
  "lines": [
   "विद्या ददाति विनयं,",
   "विनयाद् याति पात्रताम्।"
  ],
  "subtitle": "विद्या विनम्रता देती है, और विनम्रता से योग्यता आती है।",
  "author": "हितोपदेश",
  "author_en": "Hitopadesha",
  "source": "Hitopadesha, Prastavika",
  "topic_tags": [
   "#Sanskrit",
   "#Education",
   "#Subhashita"
  ]
 },
 {
  "id": "upanishad-satyameva",
  "lang": "hi",
  "hook": "भारत का आदर्श वाक्य",
  "lines": [
   "सत्यमेव जयते।"
  ],
  "subtitle": "सत्य की ही विजय होती है।",
  "author": "मुण्डक उपनिषद् 3.1.6",
  "author_en": "Mundaka Upanishad 3.1.6",
  "source": "Mundaka Upanishad 3.1.6",
  "topic_tags": [
   "#SatyamevaJayate",
   "#ProudIndian",
   "#Truth"
  ]
 },
 {
  "id": "vasudhaiva",
  "lang": "hi",
  "hook": "भारत की सोच",
  "lines": [
   "अयं निजः परो वेति",
   "गणना लघुचेतसाम्।",
   "उदारचरितानां तु",
   "वसुधैव कुटुम्बकम्॥"
  ],
  "subtitle": "उदार हृदय वालों के लिए पूरी धरती एक परिवार है।",
  "author": "महा उपनिषद्",
  "author_en": "Maha Upanishad",
  "source": "Maha Upanishad 6.71–73",
  "topic_tags": [
   "#VasudhaivaKutumbakam",
   "#ProudIndian",
   "#Unity"
  ]
 },
 {
  "id": "gita-6-5",
  "lang": "hi",
  "hook": "गीता का संदेश",
  "lines": [
   "उद्धरेदात्मनात्मानं",
   "नात्मानमवसादयेत्।"
  ],
  "subtitle": "अपना उत्थान स्वयं करें, स्वयं को कभी गिरने न दें।",
  "author": "श्रीमद्भगवद्गीता 6.5",
  "author_en": "Bhagavad Gita 6.5",
  "source": "Bhagavad Gita, Chapter 6, Verse 5",
  "topic_tags": [
   "#BhagavadGita",
   "#SelfBelief",
   "#Suvichar"
  ]
 },
 {
  "id": "gupt-nar-ho",
  "lang": "hi",
  "hook": "मैथिलीशरण गुप्त की पंक्तियाँ",
  "lines": [
   "नर हो, न निराश करो मन को।",
   "कुछ काम करो, कुछ काम करो।",
   "जग में रह कर",
   "कुछ नाम करो॥"
  ],
  "subtitle": "हिम्मत मत हारो, कर्म करते रहो।",
  "author": "मैथिलीशरण गुप्त",
  "author_en": "Maithili Sharan Gupt",
  "source": "Nar Ho Na Nirash Karo Man Ko",
  "topic_tags": [
   "#MaithiliSharanGupt",
   "#HindiKavita",
   "#NeverGiveUp"
  ]
 },
 {
  "id": "confucius-reciprocity",
  "lang": "en",
  "hook": "One word to live by:",
  "lines": [
   "Do not impose",
   "on others what",
   "you yourself",
   "do not desire."
  ],
  "subtitle": "जो आप अपने लिए नहीं चाहते, वह दूसरों के साथ मत कीजिए।",
  "author": "Confucius",
  "author_en": "Confucius",
  "source": "Analects 15.24",
  "topic_tags": [
   "#Confucius",
   "#Kindness",
   "#LifeLessons"
  ]
 },
 {
  "id": "laozi-know-self",
  "lang": "en",
  "hook": "Lao Tzu on wisdom:",
  "lines": [
   "Knowing others",
   "is intelligence;",
   "knowing yourself",
   "is true wisdom."
  ],
  "subtitle": "दूसरों को जानना बुद्धि है, खुद को जानना सच्चा ज्ञान।",
  "author": "Lao Tzu",
  "author_en": "Lao Tzu",
  "source": "Tao Te Ching, Chapter 33",
  "topic_tags": [
   "#LaoTzu",
   "#SelfAwareness",
   "#Wisdom"
  ]
 },
 {
  "id": "seneca-postpone",
  "lang": "en",
  "hook": "Seneca's warning:",
  "lines": [
   "While we are",
   "postponing,",
   "life speeds by."
  ],
  "subtitle": "हम टालते रहते हैं और जीवन निकल जाता है।",
  "author": "Seneca",
  "author_en": "Seneca",
  "source": "Letters to Lucilius, Letter 1",
  "topic_tags": [
   "#Seneca",
   "#StartToday",
   "#Stoicism"
  ]
 },
 {
  "id": "seneca-imagination",
  "lang": "en",
  "hook": "Read this when you worry:",
  "lines": [
   "We suffer more often",
   "in imagination",
   "than in reality."
  ],
  "subtitle": "हम असल से ज़्यादा कल्पना में दुखी होते हैं।",
  "author": "Seneca",
  "author_en": "Seneca",
  "source": "Letters to Lucilius, Letter 13",
  "topic_tags": [
   "#Seneca",
   "#Overthinking",
   "#Stoicism"
  ]
 },
 {
  "id": "aurelius-obstacle",
  "lang": "en",
  "hook": "Marcus Aurelius on obstacles:",
  "lines": [
   "What stands",
   "in the way",
   "becomes the way."
  ],
  "subtitle": "जो रास्ते की रुकावट है, वही रास्ता बन जाती है।",
  "author": "Marcus Aurelius",
  "author_en": "Marcus Aurelius",
  "source": "Meditations, Book 5.20",
  "topic_tags": [
   "#MarcusAurelius",
   "#Resilience",
   "#Stoicism"
  ]
 },
 {
  "id": "aurelius-happy",
  "lang": "en",
  "hook": "A 2,000-year-old truth:",
  "lines": [
   "Very little is needed",
   "to make a happy life;",
   "it is all within yourself,",
   "in your way of thinking."
  ],
  "subtitle": "खुश रहने के लिए बहुत कम चाहिए — सब आपकी सोच में है।",
  "author": "Marcus Aurelius",
  "author_en": "Marcus Aurelius",
  "source": "Meditations, Book 7.67",
  "topic_tags": [
   "#MarcusAurelius",
   "#Happiness",
   "#Mindset"
  ]
 },
 {
  "id": "epictetus-master",
  "lang": "en",
  "hook": "Epictetus on freedom:",
  "lines": [
   "No man is free",
   "who is not",
   "master of himself."
  ],
  "subtitle": "जो खुद पर काबू नहीं रखता, वह आज़ाद नहीं।",
  "author": "Epictetus",
  "author_en": "Epictetus",
  "source": "Fragments (Stobaeus)",
  "topic_tags": [
   "#Epictetus",
   "#SelfDiscipline",
   "#Stoicism"
  ]
 },
 {
  "id": "epictetus-first-say",
  "lang": "en",
  "hook": "The simplest plan:",
  "lines": [
   "First say to yourself",
   "what you would be;",
   "and then do",
   "what you have to do."
  ],
  "subtitle": "पहले तय कीजिए क्या बनना है, फिर वही कीजिए।",
  "author": "Epictetus",
  "author_en": "Epictetus",
  "source": "Discourses, Book 3.23",
  "topic_tags": [
   "#Epictetus",
   "#Goals",
   "#Discipline"
  ]
 },
 {
  "id": "roosevelt-do-what",
  "lang": "en",
  "hook": "Start where you are:",
  "lines": [
   "Do what you can,",
   "with what you have,",
   "where you are."
  ],
  "subtitle": "जो है, जहाँ हैं, उसी से शुरू कीजिए।",
  "author": "Theodore Roosevelt",
  "author_en": "Theodore Roosevelt",
  "source": "An Autobiography, 1913",
  "topic_tags": [
   "#TheodoreRoosevelt",
   "#StartToday",
   "#Motivation"
  ]
 },
 {
  "id": "thoreau-dreams",
  "lang": "en",
  "hook": "Thoreau wrote this in 1854:",
  "lines": [
   "If one advances confidently",
   "in the direction of his dreams,",
   "he will meet with a success",
   "unexpected in common hours."
  ],
  "subtitle": "सपनों की ओर भरोसे से बढ़िए, सफलता खुद मिलेगी।",
  "author": "Henry David Thoreau",
  "author_en": "Henry David Thoreau",
  "source": "Walden, 1854",
  "topic_tags": [
   "#Thoreau",
   "#Dreams",
   "#Success"
  ]
 },
 {
  "id": "keller-together",
  "lang": "en",
  "hook": "Helen Keller on teamwork:",
  "lines": [
   "Alone we can do",
   "so little;",
   "together we can do",
   "so much."
  ],
  "subtitle": "अकेले हम थोड़ा कर पाते हैं, साथ मिलकर बहुत कुछ।",
  "author": "Helen Keller",
  "author_en": "Helen Keller",
  "source": "Quoted in Helen and Teacher, Joseph P. Lash, 1980",
  "topic_tags": [
   "#HelenKeller",
   "#Teamwork",
   "#Unity"
  ]
 },
 {
  "id": "einstein-bicycle",
  "lang": "en",
  "hook": "Einstein, in a letter to his son:",
  "lines": [
   "Life is like",
   "riding a bicycle.",
   "To keep your balance",
   "you must keep moving."
  ],
  "subtitle": "ज़िंदगी साइकिल जैसी है — संतुलन के लिए चलते रहना ज़रूरी है।",
  "author": "Albert Einstein",
  "author_en": "Albert Einstein",
  "source": "Letter to Eduard Einstein, 5 February 1930",
  "topic_tags": [
   "#AlbertEinstein",
   "#KeepMoving",
   "#LifeLessons"
  ]
 },
 {
  "id": "emerson-enthusiasm",
  "lang": "en",
  "hook": "Emerson knew:",
  "lines": [
   "Nothing great",
   "was ever achieved",
   "without enthusiasm."
  ],
  "subtitle": "उत्साह के बिना कुछ भी महान हासिल नहीं होता।",
  "author": "Ralph Waldo Emerson",
  "author_en": "Ralph Waldo Emerson",
  "source": "Circles, Essays: First Series, 1841",
  "topic_tags": [
   "#Emerson",
   "#Passion",
   "#Motivation"
  ]
 },
 {
  "id": "franklin-lost-time",
  "lang": "en",
  "hook": "Benjamin Franklin's reminder:",
  "lines": [
   "Lost time",
   "is never",
   "found again."
  ],
  "subtitle": "खोया हुआ समय फिर कभी नहीं मिलता।",
  "author": "Benjamin Franklin",
  "author_en": "Benjamin Franklin",
  "source": "Poor Richard's Almanack, 1748",
  "topic_tags": [
   "#BenjaminFranklin",
   "#TimeManagement",
   "#Discipline"
  ]
 },
 {
  "id": "tagore-butterfly",
  "lang": "en",
  "hook": "Tagore on living fully:",
  "lines": [
   "The butterfly counts",
   "not months but moments,",
   "and has",
   "time enough."
  ],
  "subtitle": "तितली महीने नहीं, पल गिनती है — और उसके पास पर्याप्त समय है।",
  "author": "Rabindranath Tagore",
  "author_en": "Rabindranath Tagore",
  "source": "Fireflies, 1928",
  "topic_tags": [
   "#RabindranathTagore",
   "#LiveInTheMoment",
   "#LifeQuotes"
  ]
 },
 {
  "id": "tagore-clouds",
  "lang": "en",
  "hook": "Tagore, Stray Birds:",
  "lines": [
   "Clouds come floating",
   "into my life,",
   "no longer to carry rain,",
   "but to add colour",
   "to my sunset sky."
  ],
  "subtitle": "बादल अब बारिश नहीं, मेरी शाम में रंग भरने आते हैं।",
  "author": "Rabindranath Tagore",
  "author_en": "Rabindranath Tagore",
  "source": "Stray Birds, 1916",
  "topic_tags": [
   "#RabindranathTagore",
   "#Positivity",
   "#GoodThoughts"
  ]
 }
]